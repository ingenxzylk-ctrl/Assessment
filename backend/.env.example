# Local backend env template — copy to backend/.env and fill secrets.
# cp backend/.env.example backend/.env

PORT=5000
GEMINI_API_KEY=

# Optional — best Indian pincode reverse-geocode (Geocoding API).
# Without this key we still fill city/state from OpenStreetMap; PIN is best-effort.
# GOOGLE_MAPS_GEOCODING_KEY=
#
# IP city/state fallback (no pincode) uses ipwho.is then ipapi.co from the server.
# The quiz never prompts for GPS on its own — "Use my location" is opt-in.

# Sheets → Zylk Assessment Leads (Sheet1)
GOOGLE_SHEETS_SPREADSHEET_ID=18F3BsQIZg9InHS6jqyJJZulIU7QCP4-fgtcRIyl9MY4
GOOGLE_SHEETS_RANGE=Sheet1!A:R

# PDF links in Google Sheet always point at the VPS API (not localhost)
PUBLIC_API_URL=https://api.zylkhealth.com

# WooCommerce order webhook (Purchased column). Woo → POST /api/webhooks/woocommerce
# Settings → Advanced → Webhooks → Topic: Order updated / Order created
# Delivery URL: https://api.zylkhealth.com/api/webhooks/woocommerce
# WOO_WEBHOOK_SECRET=the-secret-from-the-woo-webhook
# Optional shared token: ?token= or header x-zylk-webhook-token
# WOO_WEBHOOK_TOKEN=

# Fail-safe report storage (defaults under backend/storage/)
# Layout: reports/YYYY/MM/TR-…/ and duplicate_reports/YYYY/MM/TR-…-DUPN/
# REPORT_STORAGE_DIR=./storage/reports
# REPORT_DUPLICATE_DIR=./storage/duplicate_reports
# REPORT_INCOMING_DIR=./storage/incoming

# Service account (recommended) — share the Sheet with this email as Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or one-line JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Or path to key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
