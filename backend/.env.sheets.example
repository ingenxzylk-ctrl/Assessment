# ── Google Sheets lead sync (calling team) ──────────────────────────
# Spreadsheet ID from:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab + columns (must match header row A–L)
GOOGLE_SHEETS_RANGE=Leads!A:L

# Public API base used to build PDF links in the Sheet
# Example: https://api.zylkhealth.com
PUBLIC_API_URL=https://api.zylkhealth.com

# Reuse Drive OAuth (refresh token MUST include Sheets scope).
# Regenerate with: node scripts/get-google-oauth-token.js
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# Or service account: share the Sheet with the service-account email as Editor
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
