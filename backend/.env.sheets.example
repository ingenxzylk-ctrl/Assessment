# ── Google Sheets lead sync (calling team) ──────────────────────────
# Spreadsheet: Zylk Assessment Leads
# https://docs.google.com/spreadsheets/d/18F3BsQIZg9InHS6jqyJJZulIU7QCP4-fgtcRIyl9MY4/edit
GOOGLE_SHEETS_SPREADSHEET_ID=18F3BsQIZg9InHS6jqyJJZulIU7QCP4-fgtcRIyl9MY4
# Tab name from the sheet (headers in row 1, Call Status dropdown on L)
GOOGLE_SHEETS_RANGE=Sheet1!A:L

# Public API base used to build PDF links in the Sheet
PUBLIC_API_URL=https://api.zylkhealth.com

# ── RECOMMENDED: Service Account (no personal Gmail OAuth / less notification risk)
# 1. Google Cloud Console → create Service Account → download JSON key
# 2. Enable Google Sheets API
# 3. Share the Sheet with the service account email as Editor
# 4. Set either JSON path/content OR email+private key below:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Alternative: OAuth (only if you already use Drive OAuth and regenerate with Sheets scope)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
