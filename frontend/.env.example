# Copy to .env.local for machine-specific overrides (not committed).
#
# Local dev (automatic when you run `npm run dev`):
#   VITE_API_URL=http://localhost:5000/api
#
# Production build (`npm run build` uses .env.production):
#   VITE_API_URL=https://api.zylkhealth.com/api
#   VITE_WP_SITE_URL=https://zylkhealth.com
#   VITE_PUBLIC_APP_URL=https://quiz.zylkhealth.com/
